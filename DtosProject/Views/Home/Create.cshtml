@model DtosProject.Models.ClientFormModel
@{ ViewData["Title"] = "Новий клієнт"; }

<div class="page-header">
    <span class="page-title">Новий клієнт</span>
    <a href="/Home/Index" class="back-link">← Назад</a>
</div>

<form method="post" action="/Home/Create">
    <div style="display:flex; flex-direction:column; gap:1rem;">
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Повне ім'я</label>
                <input type="text" name="FullName" placeholder="Введіть ім'я..." />
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" placeholder="email@mail.com" />
            </div>
            <div class="form-group">
                <label class="form-label">Вік</label>
                <input type="number" name="Age" placeholder="Вік" />
            </div>
        </div>
        <div class="form-actions">
            <a href="/Home/Index" class="btn btn-ghost">Скасувати</a>
            <button type="submit" class="btn btn-primary">Додати клієнта</button>
        </div>
    </div>
</form>