@model DtosProject.DTOs.UpdateClientDto
@{ ViewData["Title"] = "Редагування"; }

<div class="page-header">
    <span class="page-title">Редагування</span>
    <a href="/Home/Index" class="back-link">← Назад</a>
</div>

<form method="post" action="/Home/Edit">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div style="display:flex; flex-direction:column; gap:1rem;">
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Повне ім'я</label>
                <input type="text" name="FullName" value="@Model.FullName" />
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" value="@Model.Email" />
            </div>
        </div>
        <div class="form-group" style="max-width: 200px;">
            <label class="form-label">Вік</label>
            <input type="number" name="Age" value="@Model.Age" />
        </div>
        <div class="form-actions">
            <a href="/Home/Index" class="btn btn-ghost">Скасувати</a>
            <button type="submit" class="btn btn-primary">Зберегти зміни</button>
        </div>
    </div>
</form>