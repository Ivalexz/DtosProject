@model List<DtosProject.DTOs.ClientListItemDto>
@{ ViewData["Title"] = "Клієнти"; }

<div class="page-header">
    <span class="page-title">Клієнти</span>
    <a href="/Home/Create" class="btn btn-primary">+ Додати</a>
</div>

<form method="get" action="/Home/Index">
    <div class="search-row">
        <input type="text" 
               name="Request" 
               placeholder="Пошук за ім'ям або email..." 
               value="@Context.Request.Query["Request"]" />
        <button type="submit" class="btn btn-ghost">Шукати</button>
    </div>
</form>

@if (Model == null || !Model.Any())
{
    <p style="color: var(--brand-mid); font-size: 14px; padding: 1rem 0;">Клієнтів не знайдено.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>Ім'я</th>
                <th>Email</th>
                <th>Дії</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>
                        <a href="/Home/Details/@client.Id" class="action-link">Деталі</a>
                        <a href="/Home/Edit/@client.Id" class="action-link">Редагувати</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}