@{
    ViewData["Title"] = "Clients";
    var clients = ViewBag.Clients as List<DtosProject.DTOs.ClientListItemDto>;
    var search = ViewBag.Search as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clients</h2>
        <a asp-action="Create" class="btn btn-success">+ Add Client</a>
    </div>

    <form method="get" asp-action="Index" class="d-flex gap-2 mb-4">
        <input type="text" name="search" value="@search"
               class="form-control" placeholder="Search by name or email..." style="max-width: 400px;" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </form>

    @if (clients != null && clients.Count > 0)
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clients)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.FullName</td>
                        <td>@c.Email</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            @if (!string.IsNullOrEmpty(search))
            {
                <span>No clients found for "<strong>@search</strong>".</span>
            }
            else
            {
                <span>No clients yet. <a asp-action="Create">Add first client</a>.</span>
            }
        </div>
    }
</div>