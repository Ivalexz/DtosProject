@model DtosProject.DTOs.ClientDetailsDto
@{ ViewData["Title"] = "Деталі клієнта"; }

<div class="page-header">
    <span class="page-title">Деталі клієнта</span>
    <a href="/Home/Index" class="back-link">← Назад</a>
</div>

<div style="display:flex; align-items:center; gap:14px;">
    <div class="avatar">
        @(Model.FullName.Length >= 2 ? Model.FullName.Substring(0,2).ToUpper() : Model.FullName.ToUpper())
    </div>
    <div>
        <div style="font-size:18px; font-weight:500;">@Model.FullName</div>
        <span class="badge">Клієнт</span>
    </div>
</div>

<div class="divider"></div>

<div class="detail-grid">
    <div class="detail-field">
        <div class="detail-label">Email</div>
        <div class="detail-value">@Model.Email</div>
    </div>
    <div class="detail-field">
        <div class="detail-label">Вік</div>
        <div class="detail-value">@Model.Age</div>
    </div>
    <div class="detail-field" style="grid-column: span 2;">
        <div class="detail-label">Створено</div>
        <div class="detail-value">@Model.CreatedAt.ToString("dd.MM.yyyy")</div>
    </div>
</div>

<div style="margin-top:1.25rem; display:flex; gap:10px;">
    <a href="/Home/Edit/@Model.Id" class="btn btn-primary">Редагувати</a>
    <a href="/Home/Index" class="btn btn-ghost">← Назад</a>
</div>