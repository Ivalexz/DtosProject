<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { --brand-dark: #301728; --brand-light: #B7D1EA; --brand-mid: #7A9FBF; --brand-surface: #F0F7FF; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: sans-serif; background: var(--brand-surface); color: var(--brand-dark); padding: 2rem; }
        .nav { background: var(--brand-dark); border-radius: 12px; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .nav a { color: var(--brand-light); font-size: 13px; text-decoration: none; opacity: 0.75; margin-left: 1.5rem; }
        .nav a:hover { opacity: 1; }
        .nav-logo { color: var(--brand-light); font-size: 15px; font-weight: 500; }
        .card { background: #fff; border: 0.5px solid #d0dde8; border-radius: 12px; padding: 1.5rem; max-width: 820px; margin: 0 auto; animation: fadeUp 0.3s ease; }
        @@keyframes fadeUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
        .page-title { font-size: 20px; font-weight: 500; }
        .back-link { font-size: 13px; color: var(--brand-mid); text-decoration: none; }
        .back-link:hover { color: var(--brand-dark); }
        .btn { height: 36px; padding: 0 16px; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; border: none; transition: opacity 0.18s, transform 0.12s; text-decoration: none; display: inline-flex; align-items: center; }
        .btn:hover { opacity: 0.85; }
        .btn:active { transform: scale(0.97); }
        .btn-primary { background: var(--brand-dark); color: var(--brand-light); }
        .btn-ghost { background: transparent; border: 0.5px solid var(--brand-mid); color: var(--brand-dark); }
        input[type=text], input[type=email], input[type=number] { height: 38px; border: 0.5px solid var(--brand-mid); border-radius: 8px; padding: 0 12px; font-size: 14px; background: var(--brand-surface); color: var(--brand-dark); outline: none; width: 100%; }
        input:focus { border-color: var(--brand-dark); }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-label { font-size: 12px; font-weight: 500; color: var(--brand-dark); opacity: 0.7; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .form-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 0.5rem; }
        .divider { height: 0.5px; background: #d0dde8; margin: 1rem 0; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .table-wrap { overflow: hidden; border-radius: 8px; border: 0.5px solid #d0dde8; }
        thead tr { background: var(--brand-dark); }
        thead th { color: var(--brand-light); padding: 10px 14px; text-align: left; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; }
        tbody tr { border-bottom: 0.5px solid #d0dde8; transition: background 0.15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--brand-surface); }
        tbody td { padding: 10px 14px; }
        .action-link { color: var(--brand-dark); font-size: 12px; text-decoration: none; opacity: 0.65; margin-right: 10px; }
        .action-link:hover { opacity: 1; text-decoration: underline; }
        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
        .detail-field { background: var(--brand-surface); border-radius: 8px; padding: 0.75rem 1rem; }
        .detail-label { font-size: 11px; color: var(--brand-mid); font-weight: 500; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em; }
        .detail-value { font-size: 15px; color: var(--brand-dark); font-weight: 500; }
        .avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--brand-light); display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 500; color: var(--brand-dark); flex-shrink: 0; }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 500; background: var(--brand-light); color: var(--brand-dark); }
        .search-row { display: flex; gap: 10px; margin-bottom: 1rem; }
        .search-row input { flex: 1; }
    </style>
</head>
<body>
<nav class="nav">
    <span class="nav-logo">ClientSystem</span>
    <div>
        <a href="/">Список</a>
        <a href="/Home/Create">Додати клієнта</a>
    </div>
</nav>
<div class="card">
    @RenderBody()
</div>
</body>
</html>